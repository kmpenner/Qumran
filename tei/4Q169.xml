      <lb n="3"/><gap reason="lost" extent="unknown"/><supplied reason="lost">חזקי מבצ</supplied><unclear cert="low">ר</unclear><unclear cert="high">י</unclear><unclear cert="low">ך</unclear> <unclear cert="low">בו</unclear><unclear cert="high">א</unclear>י בט<unclear cert="low">י</unclear><supplied reason="lost">ט</supplied><gap reason="lost" extent="unknown"/>.
