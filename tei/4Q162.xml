      <lb n="8"/>ראו <unclear cert="high">ר</unclear><supplied reason="lost">או ואל תדעו ?</supplied><gap reason="lost" extent="unknown"/>
      <lb n="9"/>תבי <gap reason="illegible" unit="character" quantity="1"/><gap reason="lost" extent="unknown"/>.
