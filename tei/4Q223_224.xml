      <lb n="45"/><gap reason="lost" extent="unknown"/> <unclear cert="low">ד</unclear>אוה
      <lb n="46"/><supplied reason="lost">לוא נגעה בה כול ימי חייה.   ויאמר לה יעקוב אשרי אנכי אמ</supplied><unclear cert="low">י</unclear> <unclear cert="low">אם</unclear><supplied reason="lost"> תקרבנה שנ</supplied><unclear cert="low">י</unclear> לשני חי<supplied reason="lost">יך</supplied>
